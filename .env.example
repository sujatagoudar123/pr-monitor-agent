# ============================================================================
# PR Monitor Agent v2 — Environment Variables
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED — Claude (Anthropic) API key. This is the agent's brain.
# Get one at: https://console.anthropic.com
# Cost: ~$0.003 per company search (Claude Haiku) or ~$0.05 (Claude Sonnet)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Choose model: haiku is fast & cheap, sonnet is smarter at relevance ranking.
# Defaults to claude-haiku-4-5 if not set.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ----------------------------------------------------------------------------
# OPTIONAL — extra news sources (the agent uses whichever are available)
# ----------------------------------------------------------------------------

# NewsAPI.org — free 100 requests/day. Get key at https://newsapi.org
NEWSAPI_KEY=

# Bing News Search v7 — free 1,000 calls/month via Azure.
# Get key at: https://portal.azure.com → create "Bing Search v7" resource
BING_NEWS_API_KEY=

# Google News RSS — works WITHOUT a key (it's just RSS).
# No env var needed; the agent calls it directly.

# ----------------------------------------------------------------------------
# REQUIRED for email — AWS SES SMTP credentials
# ----------------------------------------------------------------------------
# Note: AWS SES, NOT SNS. SNS is pub/sub notifications; SES is email.
# Setup:
#   1. AWS Console → SES → Create SMTP credentials → save the SMTP username
#      and password (these are DIFFERENT from your IAM access keys).
#   2. Verify your sender domain (or at least your sender email).
#   3. Out of sandbox: request production access to send to any recipient.
#
# Find host for your region:
#   us-east-1 → email-smtp.us-east-1.amazonaws.com
#   us-west-2 → email-smtp.us-west-2.amazonaws.com
#   eu-west-1 → email-smtp.eu-west-1.amazonaws.com
#   ap-south-1 → email-smtp.ap-south-1.amazonaws.com
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIA_YOUR_SES_SMTP_USERNAME
SMTP_PASS=YOUR_SES_SMTP_PASSWORD
SMTP_FROM="PR Monitor <pr-monitor@yourverifieddomain.com>"
